---
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import RbacApp from "@/components/admin/rbac/RbacApp";
import AdminShell from "@/layouts/AdminShell.astro";
import type {AdminMenuCode} from "@/shared/AdminNavigation";
import type {RbacBoard} from "@/shared/Rbac";
import type {FeedContent, OnboardingResult} from "@/types";

/**
 * The shell the RBAC board page uses: the admin chrome around `RbacApp`.
 *
 * Roles and their grants are one indivisible screen, so there is exactly one
 * page for them (`/rbac/`). It used to have a twin at `/rbac/permissions/`
 * guarded by a second code (`system:permission:manage`); the two were byte-for-
 * byte the same board, and migration 0065 merged the codes and dropped the
 * twin. This component keeps the chrome in one place in case a second board
 * page ever earns its keep again.
 *
 * The page keeps its own `requirePagePermission` call — the guard code is what
 * ties a page to its menu row, and `tests/unit/admin-page-guards.test.ts` reads
 * it from the page file — and it narrows `Astro.locals` before handing the
 * context in, which is why the context arrives here as required props.
 */
interface Props {
  activeNavItem: AdminMenuCode | null;
  board: RbacBoard;
  documentTitle: string;
  feedContent: FeedContent;
  onboardingResult: OnboardingResult;
  pageTitle: string;
}

const {
  activeNavItem,
  board,
  documentTitle,
  feedContent,
  onboardingResult,
  pageTitle,
} = Astro.props;
---

<AdminShell
  {activeNavItem}
  {documentTitle}
  {feedContent}
  {onboardingResult}
  {pageTitle}
>  <RbacApp client:only="react" initialBoard={board}>
    <AdminPageFallback slot="fallback" kind="list" />
  </RbacApp>
</AdminShell>
