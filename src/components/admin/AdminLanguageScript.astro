<script is:inline>
  (() => {
    const storageKey = "microfeed-admin-language";
    const cookieKey = "microfeed-admin-language";
    const eventName = "microfeed:admin-language-change";
    const allowed = new Set(["en", "zh-CN"]);
    const preference = () => {
      try {
        const stored = localStorage.getItem(storageKey);
        if (allowed.has(stored)) return stored;
      } catch {}
      try {
        const match = document.cookie.match(
          new RegExp("(?:^|; )" + cookieKey + "=([^;]+)")
        );
        if (match && allowed.has(match[1])) return match[1];
      } catch {}
      return navigator.language && /^zh([-_]|$)/i.test(navigator.language)
        ? "zh-CN"
        : "en";
    };
    const apply = () => {
      document.documentElement.lang = preference();
    };

    apply();
    if (!window.__microfeedAdminLanguageReady) {
      window.__microfeedAdminLanguageReady = true;
      window.addEventListener("storage", apply);
      window.addEventListener(eventName, apply);
      document.addEventListener("astro:after-swap", apply);
    }
  })();
</script>
