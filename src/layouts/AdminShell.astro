---
import {env} from "cloudflare:workers";
import "@fontsource-variable/geist";
import {ClientRouter} from "astro:transitions";

import AdminSidebar from "@/components/admin/AdminSidebar";
import AdminAccountSidebar from "@/components/admin/account/AdminAccountSidebar";
import AdminThemeScript from "@/components/admin/AdminThemeScript.astro";
import AdminLanguageScript from "@/components/admin/AdminLanguageScript.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import {Toaster} from "@/components/ui/sonner";
import {adminChannelSummary} from "@/components/admin/admin-shell-types";
import type {
  AdminBreadcrumb,
  AdminAccountSidebarData,
  AdminDeploymentSummary,
  AdminIdentitySummary,
  AdminSidebarData,
} from "@/components/admin/admin-shell-types";
import {cloudflareAccessIdentity} from "@/server/auth/admin-protection";
import {adminUrl, normalizeAdminPath} from "@/shared/AdminPath";
import {
  adminLanguageFromRequest,
  type AdminLanguage,
} from "@/shared/AdminLanguage";
import type {AdminMenuCode} from "@/shared/AdminNavigation";
import {readAdminMenu} from "@/server/admin/menu";
import type {AdminAccountSection} from "@/shared/AdminAccountNavigation";
import type {AdminApiPageId} from "@/shared/AdminApiNavigation";
import type {AdminWebhookPageId} from "@/shared/AdminWebhookNavigation";
import {ADMIN_MENU_CODES} from "@/shared/Constants";
import {
  PUBLIC_URLS,
  resolvePublicBucketUrl,
  urlJoinWithRelative,
} from "@/shared/StringUtils";
import type {FeedContent, OnboardingResult} from "@/types";
import adminStylesheetUrl from "@/styles/admin-stylesheet";
import "@/styles/interactive.css";

export type {AdminBreadcrumb};

interface Props {
  accountActiveSection?: AdminAccountSection["id"];
  accountNavigation?: boolean;
  activeNavItem: AdminMenuCode | null;
  apiActivePage?: AdminApiPageId;
  breadcrumb?: AdminBreadcrumb;
  documentTitle?: string;
  feedContent: FeedContent;
  onboardingResult: OnboardingResult;
  pageTitle: string;
  webhookActivePage?: AdminWebhookPageId;
}

const {
  accountActiveSection,
  accountNavigation = false,
  activeNavItem,
  apiActivePage = "overview",
  breadcrumb,
  documentTitle,
  feedContent,
  onboardingResult,
  pageTitle,
  webhookActivePage = "overview",
} = Astro.props;
const adminPath = normalizeAdminPath(env.MICROFEED_ADMIN_PATH);
const adminLanguage: AdminLanguage = adminLanguageFromRequest(Astro.request);
const accessIdentity = cloudflareAccessIdentity(Astro.request);
const identity: AdminIdentitySummary = {
  builtInEmail: Astro.locals.authUser?.email,
  cloudflareAccessDetected: accessIdentity.detected,
  cloudflareAccessEmail: accessIdentity.email,
};
const protectedDashboard = Boolean(
  identity.builtInEmail || identity.cloudflareAccessDetected,
);
const versionTag = env.CF_VERSION_METADATA.tag?.trim().toLowerCase();
const productionWorkerName = protectedDashboard &&
    env.DEPLOYMENT_ENVIRONMENT === "production" &&
    env.MICROFEED_CLOUDFLARE_ACCOUNT_ID?.trim() &&
    env.MICROFEED_WORKER_NAME?.trim()
  ? env.MICROFEED_WORKER_NAME.trim()
  : undefined;
const deployment: AdminDeploymentSummary = {
  deployedAt: env.CF_VERSION_METADATA.timestamp,
  protected: protectedDashboard,
  productionWorkerName,
  sourceCommit: protectedDashboard && versionTag && /^[0-9a-f]{40}$/u.test(versionTag)
    ? versionTag
    : undefined,
};

const channel = feedContent.channel ?? {};
const channelImage = typeof channel.image === "string" && channel.image.trim()
  ? channel.image.trim()
  : undefined;
const publicBucketUrl = resolvePublicBucketUrl(
  feedContent.settings?.webGlobalSettings?.publicBucketUrl,
  Astro.url.hostname,
);
const channelImageUrl = channelImage
  ? urlJoinWithRelative(publicBucketUrl, channelImage, Astro.url.origin) ?? undefined
  : undefined;
const menuItems = await readAdminMenu(
  env.FEED_DB,
  Astro.locals,
  adminPath,
  activeNavItem,
  onboardingResult.requiredOk,
);
// 当前页处于 API / Webhooks 的哪个子页上：子项是主菜单注入出来的第三级，
// 在权限树里没有对应节点，位置只能由页面告知侧栏。
const activeSubItem = activeNavItem === ADMIN_MENU_CODES.API
  ? {code: ADMIN_MENU_CODES.API, id: apiActivePage}
  : activeNavItem === ADMIN_MENU_CODES.WEBHOOKS
    ? {code: ADMIN_MENU_CODES.WEBHOOKS, id: webhookActivePage}
    : undefined;
const sidebar: AdminSidebarData = {
  // 树形侧栏的展开态按账号记忆：内置登录用 authUser id，
  // Access 模式用 email；都没有（未保护的看板）时退回全局键。
  accountKey: Astro.locals.authUser?.id ?? accessIdentity.email,
  activeSubItem,
  channel: adminChannelSummary(channel.title, channelImageUrl),
  deployment,
  items: menuItems,
  newItem: {
    disabled: !onboardingResult.requiredOk,
    url: adminUrl("items/new", adminPath),
  },
  publicLinks: {
    json: PUBLIC_URLS.jsonFeed(Astro.url.origin),
    rss: PUBLIC_URLS.rssFeed(Astro.url.origin),
    website: PUBLIC_URLS.webFeed(Astro.url.origin),
  },
};
const accountSidebar: AdminAccountSidebarData | undefined = accountNavigation
  ? {
      activeSection: accountActiveSection,
      backUrl: adminUrl("", adminPath),
      deployment,
      sectionsUrl: adminUrl("account", adminPath),
    }
  : undefined;
---

<!doctype html>
<html
  class="lg:h-full lg:overflow-hidden"
  lang={adminLanguage}
  transition:name="admin-root"
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="microfeed-admin-path" content={adminPath} />
    <meta
      name="microfeed-webmcp-enabled"
      content={protectedDashboard ? "true" : "false"}
    />
    <title>{documentTitle ?? `${pageTitle} | microfeed.org`}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <link rel="stylesheet" href={adminStylesheetUrl} />
    <AdminLanguageScript />
    <AdminThemeScript />
    <ClientRouter fallback="swap" />
  </head>
  <body class="lg:h-full lg:overflow-hidden">
    <div class="min-h-svh bg-admin-canvas lg:flex lg:h-svh lg:min-h-0 lg:gap-3 lg:overflow-hidden">
      <aside
        class="sticky top-0 hidden h-svh w-[17rem] shrink-0 overflow-hidden bg-sidebar lg:block"
      >
        {
          accountSidebar ? (
            <AdminAccountSidebar client:only="react" data={accountSidebar} />
          ) : (
            // 主侧栏不能加 transition:persist：持久化的岛屿不随导航更新 props，
            // 高亮与顶层手风琴会对不上当前页；展开态由 menu-open-state 的
            // store 自己跨页保持，不需要 persist。
            <AdminSidebar client:only="react" data={sidebar} />
          )
        }
      </aside>
      <section class="min-h-svh min-w-0 flex-1 bg-background lg:mt-3 lg:flex lg:h-[calc(100svh-0.75rem)] lg:min-h-0 lg:flex-col lg:overflow-hidden lg:rounded-tl-[var(--radius-shell)] lg:border lg:border-r-0 lg:border-b-0 lg:shadow-xs">
        <AdminTopBar
          {accountSidebar}
          {adminPath}
          {breadcrumb}
          {identity}
          {pageTitle}
          {sidebar}
        >
          <div slot="toolbar"><slot name="toolbar" /></div>
        </AdminTopBar>
        <main
          class="min-h-0 w-full lg:flex-1 lg:overscroll-contain lg:overflow-y-auto"
          id="admin-page-content"
        >
          <div class="mx-auto w-full max-w-[90rem] p-4 sm:p-6 xl:p-8">
            <slot />
          </div>
        </main>
      </section>
    </div>

    <Toaster
      client:load
      closeButton
      offset={{top: 80, right: 24}}
      position="top-right"
      richColors
      transition:persist="admin-toaster"
    />

    <script>
      import {
        adminUrl,
        browserAdminPath,
        isAdminPathname,
      } from "@/shared/AdminPath";
      import {nativeWebMcpAvailable} from
        "@/client/webmcp/feature-detection";

      type WebMcpAdminModule = typeof import("@/client/webmcp/admin-tools");

      let webMcpAdminModule: Promise<WebMcpAdminModule> | undefined;

      const reconcileWebMcp = async () => {
        if (!nativeWebMcpAvailable()) {
          if (webMcpAdminModule) {
            (await webMcpAdminModule).clearAdminWebMcpTools();
          }
          return;
        }
        webMcpAdminModule ??= import("@/client/webmcp/admin-tools");
        await (await webMcpAdminModule).reconcileAdminWebMcpTools();
      };

      const staysInProtectedAdmin = (destination: URL) => {
        const configuredAdminPath = browserAdminPath();
        const loginPath = adminUrl("login", configuredAdminPath);
        const goesToLogin =
          destination.pathname === loginPath.slice(0, -1) ||
          destination.pathname.startsWith(loginPath);
        return isAdminPathname(destination.pathname, configuredAdminPath) &&
          !goesToLogin;
      };

      document.addEventListener("astro:before-preparation", (event) => {
        if (!staysInProtectedAdmin(event.to)) {
          event.preventDefault();
          return;
        }

        const loadDestination = event.loader;
        event.loader = async () => {
          await loadDestination();
          if (!staysInProtectedAdmin(event.to)) {
            event.preventDefault();
          }
        };
      });
      document.addEventListener("astro:page-load", () => {
        void reconcileWebMcp().catch((error) => console.warn(
          "microfeed could not register WebMCP tools.",
          error,
        ));
      });
    </script>
  </body>
</html>
