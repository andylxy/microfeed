---
import {env} from "cloudflare:workers";

import {escapeHtml} from "@/shared/StringUtils";
import {renderTcmMarkers, type TcmMarkerStyle} from "@/shared/TcmMarkers";
import FrontLayout from "@/layouts/FrontLayout.astro";
import BookDetail from "@/components/front/BookDetail.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadFrontSite, shouldHideFrontSite} from "@/server/catalog/site";
import {getBookInfoById} from "@/server/catalog/books";
import {listGroups, type CatalogGroup} from "@/server/catalog/groups";
import {
  listVolumesByBook,
  loadMarkerStyles,
  type CatalogVolume,
} from "@/server/catalog/chapters";
import {
  listTermsByBook,
  listFangByBook,
  type CatalogTermEntry,
  type CatalogFangRef,
} from "@/server/catalog/entries";

const bookId = Astro.params.id ?? "";
const db = env.FEED_DB;
const site = await loadFrontSite(db, Astro.request);
const book = await getBookInfoById(db, bookId);
// 两行容器书在 book_info 已软删，getBookInfoById 查不到即 404，不需要容器书判定。
const unavailable = shouldHideFrontSite(site) || !book;
if (unavailable) {
  Astro.response.status = 404;
}

let volumes: CatalogVolume[] = [];
let terms: CatalogTermEntry[] = [];
let fang: CatalogFangRef[] = [];
let groups: CatalogGroup[] = [];
let styles: TcmMarkerStyle[] = [];
if (book && !unavailable) {
  [volumes, terms, fang, groups, styles] = await Promise.all([
    listVolumesByBook(db, bookId),
    listTermsByBook(db, bookId),
    listFangByBook(db, bookId),
    listGroups(db),
    loadMarkerStyles(db),
  ]);
}
const categoryLabel = book
  ? (groups.find((group) => group.key === book.caseDivision)?.label ?? "")
  : "";
// 卷名带标记（14 个）走标注层同一渲染器；目录项本身是 <a>，不传 resolveHref。
const volumeLinks = volumes.map((volume) => ({
  id: volume.id,
  name: volume.name,
  nameHtml: renderTcmMarkers(escapeHtml(volume.name), styles, {}),
  url: `/book/${bookId}/v/${volume.id}/`,
}));
---

{unavailable || !book ? (
  <PublicNotFoundHeading />
) : (
  <FrontLayout site={site} title={book.title} description={book.description}>
    <BookDetail
      view="book"
      book={book}
      categoryLabel={categoryLabel}
      volumes={volumeLinks}
      terms={terms}
      fang={fang}
    />
  </FrontLayout>
)}
