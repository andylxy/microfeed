---
import {env} from "cloudflare:workers";

import {markersToPlainText} from "@/shared/TcmMarkers";
import FrontLayout from "@/layouts/FrontLayout.astro";
import BookDetail from "@/components/front/BookDetail.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadFrontSite, shouldHideFrontSite} from "@/server/catalog/site";
import {getBookInfoById} from "@/server/catalog/books";
import {listVolumesByBook, getVolumeWithSections} from "@/server/catalog/chapters";
import {buildTcmMarkerLayer} from "@/server/tcm/markerPopover";

const bookId = Astro.params.id ?? "";
const volumeId = Astro.params.volumeId ?? "";
const db = env.FEED_DB;
const site = await loadFrontSite(db, Astro.request);
const book = await getBookInfoById(db, bookId);
const volumes = book ? await listVolumesByBook(db, bookId) : [];
const volumeIndex = volumes.findIndex((entry) => entry.id === volumeId);
// 卷必须属于这本书；volumeIndex < 0 时连正文都不查，避免跨书串卷。
const volume = volumeIndex >= 0 && !shouldHideFrontSite(site)
  ? await getVolumeWithSections(db, volumeId)
  : null;
const unavailable = shouldHideFrontSite(site) || !book || !volume || volumeIndex < 0;
if (unavailable) {
  Astro.response.status = 404;
}

// 标注层按卷只建一次：把该卷条文的 bodySource 用 HTML 注释分隔符合并、渲染一次、
// 再按分隔符切回。bodySource 保留标记字面，与旧链路 bodyToHtml 的输入同构。
const SECTION_SPLIT = "\n<!--MF-SECTION-SPLIT-->\n";
const markerLayer = !unavailable && volume
  ? await buildTcmMarkerLayer(db, {
      bodyHtml: volume.sections.map((section) => section.bodySource).join(SECTION_SPLIT),
      title: volume.name,
      currentBookId: bookId,
    })
  : null;
const splitParts = markerLayer
  ? markerLayer.bodyHtml.split(SECTION_SPLIT)
  : null;
const splitAligned = splitParts?.length === (volume?.sections.length ?? -1);
if (markerLayer && !splitAligned) {
  console.error(JSON.stringify({
    message: "TCM volume marker layer split misaligned; falling back to rendered bodies",
    bookId,
    volumeId,
    expected: volume?.sections.length ?? 0,
    got: splitParts?.length ?? 0,
  }));
}
const volumeSections = (volume?.sections ?? []).map((section, index) => ({
  id: section.id,
  bodyHtml: splitAligned && splitParts ? splitParts[index]! : section.bodyHtml,
}));
const volumeUrl = (id: string) => `/book/${bookId}/v/${id}/`;
const prevVolume = volumeIndex > 0 ? volumes[volumeIndex - 1] : undefined;
const nextVolume = volumeIndex >= 0 && volumeIndex < volumes.length - 1
  ? volumes[volumeIndex + 1]
  : undefined;
const pageTitle = volume
  ? `${markersToPlainText(volume.name)} · ${markersToPlainText(book?.title ?? "")}`
  : markersToPlainText(book?.title ?? site.title);
---

{unavailable || !book || !volume ? (
  <PublicNotFoundHeading />
) : (
  <FrontLayout
    site={site}
    title={pageTitle}
    description={book.description}
    runtimeHtml={markerLayer?.runtimeHtml ?? null}
    isReaderPage={true}
  >
    <BookDetail
      view="volume"
      book={book}
      volumeName={volume.name}
      volumeNameHtml={markerLayer?.titleHtml ?? null}
      volumeNameText={markersToPlainText(volume.name)}
      volumeSections={volumeSections}
      prevVolume={prevVolume
        ? {text: markersToPlainText(prevVolume.name), url: volumeUrl(prevVolume.id)}
        : null}
      nextVolume={nextVolume
        ? {text: markersToPlainText(nextVolume.name), url: volumeUrl(nextVolume.id)}
        : null}
    />
  </FrontLayout>
)}
