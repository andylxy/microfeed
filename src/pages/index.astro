---
import {env} from "cloudflare:workers";

import FrontLayout from "@/layouts/FrontLayout.astro";
import HomeShelf from "@/components/front/HomeShelf.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadFrontSite, shouldHideFrontSite} from "@/server/catalog/site";
import {listAllBooks, type CatalogBook} from "@/server/catalog/books";
import {listGroups, type CatalogGroup} from "@/server/catalog/groups";

const db = env.FEED_DB;
const site = await loadFrontSite(db, Astro.request);
const unavailable = shouldHideFrontSite(site);
if (unavailable) {
  Astro.response.status = 404;
}
let books: CatalogBook[] = [];
let groups: CatalogGroup[] = [];
if (!unavailable) {
  [books, groups] = await Promise.all([listAllBooks(db), listGroups(db)]);
}
---

{unavailable ? (
  <PublicNotFoundHeading />
) : (
  <FrontLayout site={site}>
    <HomeShelf books={books} groups={groups} />
  </FrontLayout>
)}
