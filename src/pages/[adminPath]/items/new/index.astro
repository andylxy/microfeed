---
import EditItemApp from "@/components/admin/items/EditItemApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "../../../../layouts/AdminShell.astro";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {requirePagePermission} from "@/server/rbac/page-guard";
import {PERMISSION_CODES} from "@/shared/Constants";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// Same code as `items/list` and `items/[itemId]`: a section's `new` form reuses
// the code of the menu row it belongs to (`all_items`), which is how
// `pages/new` and `site-files/new` already work. Actually creating the chapter
// is still gated by `content:chapter:create` on the write path
// (`ajax/feed.ts`), so opening this form grants nothing.
const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.CONTENT_CHAPTER_READ, adminLanguage);
if (denied) {
  return denied;
}
---

<AdminShell
  activeNavItem={null}
  documentTitle={translate("pageDocumentTitle.newItem", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.newItem", adminLanguage)}
>
  <EditItemApp client:only="react" {feedContent} {onboardingResult}>
    <AdminPageFallback slot="fallback" kind="form" />
  </EditItemApp>
</AdminShell>
