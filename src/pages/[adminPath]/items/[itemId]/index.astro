---
import {env} from "cloudflare:workers";

import {ADMIN_MENU_CODES, STATUSES, PERMISSION_CODES} from "@/shared/Constants";
import {adminUrl} from "@/shared/AdminPath";
import {resolveAdminReturnTarget} from "@/shared/AdminReturnTarget";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import EditItemApp from "@/components/admin/items/EditItemApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "../../../../layouts/AdminShell.astro";
import {loadFeed} from "@/server/feed/feed";
import {requirePagePermission} from "@/server/rbac/page-guard";

const itemId = Astro.params.itemId ?? "";
const adminLanguage = adminLanguageFromRequest(Astro.request);
const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.CONTENT_CHAPTER_READ, adminLanguage);
if (denied) {
  return denied;
}
const loaded = await loadFeed(env, Astro.request, {
  adminProtection: Astro.locals.adminProtection,
  limit: 1,
  queryKwargs: {id: itemId},
});
const item = loaded.content.items?.[0];
const missing = !item || item.status === STATUSES.DELETED;
if (missing) {
  Astro.response.status = 404;
} else {
  loaded.content.item = item;
}

// 返回链接跟随来源（ADR-0036）：从卷看板点进来的条目回到那一卷，其余入口
// 维持原来的「查看全部条目」。来源由看板在链接上自报，未知或残缺的来源
// 一律退回默认目标，所以手改地址最多只是回到列表，不会被带到别处。
const returnTarget = resolveAdminReturnTarget(
  Astro.url.searchParams,
  Astro.params.adminPath,
);
const breadcrumb = {
  kind: "back" as const,
  name: translate(
    returnTarget?.labelKey ?? "menu.item.all_items",
    adminLanguage,
  ),
  url: returnTarget?.url ?? adminUrl("items/list", Astro.params.adminPath),
};
---

<AdminShell
  activeNavItem={returnTarget?.menuCode ?? ADMIN_MENU_CODES.ALL_ITEMS}
  documentTitle={missing
    ? translate("pageDocumentTitle.itemNotFound", adminLanguage)
    : `${translate("pageMessage.editItemTitle", adminLanguage, {id: itemId})} | microfeed.org`}
  feedContent={loaded.content}
  onboardingResult={loaded.onboarding}
  pageTitle={missing
    ? translate("pageTitle.itemNotFound", adminLanguage)
    : translate("pageTitle.editItem", adminLanguage)}
  breadcrumb={breadcrumb}
>
  {
    missing ? (
      <section class="rounded-[14px] border bg-card p-5 text-card-foreground shadow-xs" aria-labelledby="not-found-title">
        <h1 class="mb-4 text-lg font-semibold tracking-tight" id="not-found-title">{translate("pageTitle.itemNotFound", adminLanguage)}</h1>
        <p>{translate("pageMessage.itemNotFound", adminLanguage)}</p>
      </section>
    ) : (
      <EditItemApp
        client:only="react"
        feedContent={loaded.content}
        onboardingResult={loaded.onboarding}
        returnUrl={returnTarget?.url}
        {itemId}
      >
        <AdminPageFallback slot="fallback" kind="form" />
      </EditItemApp>
    )
  }
</AdminShell>
