---
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import TcmEntryBoardApp from "@/components/admin/tcm-entry/TcmEntryBoardApp";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {normalizeAdminItemListLimit} from "@/shared/AdminCollections";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {hasPermission} from "@/server/rbac/guard";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.CONTENT_TERM_READ, adminLanguage);
if (denied) {
  return denied;
}
// Write controls need `content:term:manage` — endpoint-enforced, surfaced here so
// a read-only account doesn't see buttons that would 403.
const canManage = hasPermission(Astro.locals, PERMISSION_CODES.CONTENT_TERM_MANAGE);
// Page size for the board's footer paging comes from the same Settings → Items
// setting the items list and the volume/fang boards use.
const webSettings = feedContent.settings?.webGlobalSettings ?? {};
const itemsPerPage = normalizeAdminItemListLimit(webSettings.itemsPerPage);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.TERM}
  documentTitle={translate("pageDocumentTitle.term", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.term", adminLanguage)}
>
  <TcmEntryBoardApp
    canManage={canManage}
    client:only="react"
    itemsPerPage={itemsPerPage}
    kind="term"
    namespace="term"
  >
    <AdminPageFallback slot="fallback" kind="list" />
  </TcmEntryBoardApp>
</AdminShell>
