---
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import AnnouncementsApp from "@/components/admin/announcements/AnnouncementsApp";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {normalizeAdminItemListLimit} from "@/shared/AdminCollections";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {hasPermission} from "@/server/rbac/guard";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// Guarded with the same code its menu row binds (`system:announcement:read`);
// writing needs `system:announcement:manage` (endpoint-enforced, surfaced here so a
// read-only account does not see save buttons that would 403).
const denied = requirePagePermission(
  Astro.locals,
  PERMISSION_CODES.SYSTEM_ANNOUNCEMENT_READ,
  adminLanguage,
);
if (denied) {
  return denied;
}
const canManage = hasPermission(
  Astro.locals,
  PERMISSION_CODES.SYSTEM_ANNOUNCEMENT_MANAGE,
);
// Page size comes from Settings → Items "每页条目数", same as the other boards.
const webSettings = feedContent.settings?.webGlobalSettings ?? {};
const itemsPerPage = normalizeAdminItemListLimit(webSettings.itemsPerPage);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.ANNOUNCEMENTS}
  documentTitle={translate("pageDocumentTitle.announcements", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.announcements", adminLanguage)}
>
  <AnnouncementsApp canManage={canManage} client:only="react" {itemsPerPage}>
    <AdminPageFallback slot="fallback" kind="list" />
  </AnnouncementsApp>
</AdminShell>
