---
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import DevicesApp from "@/components/admin/devices/DevicesApp";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {normalizeAdminItemListLimit} from "@/shared/AdminCollections";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {hasPermission} from "@/server/rbac/guard";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// Guarded with the same code its menu row binds (`system:device:read`); revoke /
// restore need `system:device:manage` (endpoint-enforced, surfaced here so a
// read-only account does not see buttons that would 403).
const denied = requirePagePermission(
  Astro.locals,
  PERMISSION_CODES.SYSTEM_DEVICE_READ,
  adminLanguage,
);
if (denied) {
  return denied;
}
const canManage = hasPermission(Astro.locals, PERMISSION_CODES.SYSTEM_DEVICE_MANAGE);
// Page size for the device table's footer paging comes from the same
// Settings → Items "每页条目数" setting the other boards use (AGENTS.md).
const webSettings = feedContent.settings?.webGlobalSettings ?? {};
const itemsPerPage = normalizeAdminItemListLimit(webSettings.itemsPerPage);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.DEVICES}
  documentTitle={translate("pageDocumentTitle.devices", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.devices", adminLanguage)}
>
  <DevicesApp canManage={canManage} client:only="react" {itemsPerPage}>
    <AdminPageFallback slot="fallback" kind="list" />
  </DevicesApp>
</AdminShell>
