---
import {env} from "cloudflare:workers";

import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import ApiCredentialsApp from "@/components/admin/api/ApiCredentialsApp";
import {
  listApiKeysForUser,
  readApiAccessSettings,
} from "@/server/api/api-keys";
import {ADMIN_MENU_CODES} from "@/shared/Constants";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}
const userId = Astro.locals.authUser?.id;
if (!userId) {
  throw new Error(translate("errors.account.notFound", adminLanguage));
}
const [initialCredentials, initialSettings] = await Promise.all([
  listApiKeysForUser(env.FEED_DB, userId),
  readApiAccessSettings(env.FEED_DB),
]);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.API}
  apiActivePage="credentials"
  apiNavigation
  documentTitle={translate("pageDocumentTitle.apiCredentials", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.apiCredentials", adminLanguage)}
>
  <div class="mx-auto max-w-6xl">
    <ApiCredentialsApp
      client:only="react"
      {initialCredentials}
      {initialSettings}
      userId={userId}
    >
      <AdminPageFallback slot="fallback" kind="settings" />
    </ApiCredentialsApp>
  </div>
</AdminShell>
