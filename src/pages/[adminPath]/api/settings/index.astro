---
import {env} from "cloudflare:workers";

import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import ApiSettingsApp from "@/components/admin/api/ApiSettingsApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {readApiAccessSettings} from "@/server/api/api-keys";
import {NAV_ITEMS} from "@/shared/Constants";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}
const initialSettings = await readApiAccessSettings(env.FEED_DB);
---

<AdminShell
  activeNavItem={NAV_ITEMS.API}
  apiActivePage="settings"
  apiNavigation
  documentTitle={translate("pageDocumentTitle.apiSettings", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.apiSettings", adminLanguage)}
>
  <div class="mx-auto max-w-5xl">
    <ApiSettingsApp client:only="react" {initialSettings}>
      <AdminPageFallback slot="fallback" kind="settings" />
    </ApiSettingsApp>
  </div>
</AdminShell>
