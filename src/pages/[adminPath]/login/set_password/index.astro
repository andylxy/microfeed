---
import {env} from "cloudflare:workers";

import {normalizeAdminPath} from "@/shared/AdminPath";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import AdminPasswordSetupApp from "@/components/admin/AdminPasswordSetupApp";
import AdminLoginShell from "../../../../layouts/AdminLoginShell.astro";
import {currentAdminPasswordSetup} from "@/server/auth/password-setup";

const adminPath = normalizeAdminPath(env.MICROFEED_ADMIN_PATH);
const adminLanguage = adminLanguageFromRequest(Astro.request);
const setup = await currentAdminPasswordSetup(env.FEED_DB, Astro.request);
if (!setup) {
  return new Response(
    translate("pageMessage.passwordLinkExpired", adminLanguage),
    {
      headers: {
        "Cache-Control": "no-store",
        "content-type": "text/plain; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow",
      },
      status: 410,
    },
  );
}
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<AdminLoginShell title={translate("pageDocumentTitle.createAdminPassword", adminLanguage)} {adminPath}>
  <AdminPasswordSetupApp
    client:only="react"
    email={setup.email}
    purpose={setup.purpose}
  />
</AdminLoginShell>
