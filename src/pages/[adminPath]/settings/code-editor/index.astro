---
import {CODE_TYPES, NAV_ITEMS} from "@/shared/Constants";
import {adminUrl} from "@/shared/AdminPath";
import Theme from "@/server/themes/Theme";
import CustomCodeEditorApp, {
  type ThemeTemplate,
} from "@/components/admin/code-editor/CustomCodeEditorApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "../../../../layouts/AdminShell.astro";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, feedDb, onboardingResult} = Astro.locals;
if (!feedContent || !feedDb || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

const requestedCodeType = Astro.url.searchParams.get("type");
if (
  (requestedCodeType && requestedCodeType !== CODE_TYPES.SHARED) ||
  Astro.url.searchParams.has("theme")
) {
  return Astro.redirect(adminUrl("settings/themes", Astro.params.adminPath), 302);
}

const theme = new Theme(
  await feedDb.getPublicJsonData(feedContent),
  feedContent.settings,
  CODE_TYPES.SHARED,
);
const themeTemplate: ThemeTemplate = {
  webBodyStart: theme.getWebBodyStartTmpl(),
  webBodyEnd: theme.getWebBodyEndTmpl(),
  webHeader: theme.getWebHeaderTmpl(),
};
---

<AdminShell
  activeNavItem={NAV_ITEMS.SETTINGS}
  documentTitle={translate("pageDocumentTitle.codeEditor", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.codeEditor", adminLanguage)}
  settingsActiveSection="custom-code"
  settingsNavigation
  breadcrumb={{
    name: translate("pageTitle.settings", adminLanguage),
    url: adminUrl("settings", Astro.params.adminPath),
    childName: translate("pageTitle.codeEditor", adminLanguage),
  }}
>
  <CustomCodeEditorApp client:only="react" {feedContent} {themeTemplate}>
    <AdminPageFallback slot="fallback" kind="editor" />
  </CustomCodeEditorApp>
</AdminShell>
