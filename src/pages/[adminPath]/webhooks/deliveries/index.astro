---
import {env} from "cloudflare:workers";

import WebhookDeliveriesApp from "@/components/admin/webhooks/WebhookDeliveriesApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {getWebhookDelivery, listWebhookDeliveries, listWebhookEndpoints} from "@/server/webhooks/store";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));

const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.SYSTEM_WEBHOOK_MANAGE, adminLanguage);
if (denied) {
  return denied;
}
const deliveryId = Astro.url.searchParams.get("delivery_id");
const [initialDeliveries, endpoints, initialSelected] = await Promise.all([
  listWebhookDeliveries(env.FEED_DB),
  listWebhookEndpoints(env.FEED_DB),
  deliveryId ? getWebhookDelivery(env.FEED_DB, deliveryId) : null,
]);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.WEBHOOKS}
  documentTitle={translate("pageDocumentTitle.webhookDeliveries", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.webhookDeliveries", adminLanguage)}
  webhookActivePage="deliveries"
  webhookNavigation
>
  <WebhookDeliveriesApp client:only="react" {endpoints} {initialDeliveries} initialSelected={initialSelected ?? undefined} />
</AdminShell>
