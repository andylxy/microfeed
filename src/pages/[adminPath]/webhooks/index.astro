---
import {env} from "cloudflare:workers";

import WebhookOverviewApp from "@/components/admin/webhooks/WebhookOverviewApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {webhookOverview} from "@/server/webhooks/store";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {isLocalDevelopmentHostname} from "@/shared/StringUtils";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));

const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.SYSTEM_WEBHOOK_MANAGE, adminLanguage);
if (denied) {
  return denied;
}
const overview = await webhookOverview(env);
const localDevelopment = isLocalDevelopmentHostname(Astro.url.hostname);
const instanceName = env.MICROFEED_INSTANCE_NAME?.trim() || "<name>";
const deploymentEnvironment = env.DEPLOYMENT_ENVIRONMENT ?? "production";
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.WEBHOOKS}
  documentTitle={translate("pageDocumentTitle.webhooks", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.webhooks", adminLanguage)}
  webhookActivePage="overview"
  webhookNavigation
>
  <div class="mx-auto max-w-6xl">
    <WebhookOverviewApp client:only="react" {deploymentEnvironment} {instanceName} {localDevelopment} {overview} />
  </div>
</AdminShell>
