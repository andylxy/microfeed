---
import {env} from "cloudflare:workers";

import WebhookEndpointsApp from "@/components/admin/webhooks/WebhookEndpointsApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {listWebhookEndpoints, webhookOverview} from "@/server/webhooks/store";
import {NAV_ITEMS} from "@/shared/Constants";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
const [initialEndpoints, overview] = await Promise.all([
  listWebhookEndpoints(env.FEED_DB),
  webhookOverview(env),
]);
const initialQuickstart = Astro.url.searchParams.get("quickstart") === "1";
---

<AdminShell
  activeNavItem={NAV_ITEMS.WEBHOOKS}
  documentTitle={translate("pageDocumentTitle.webhookEndpoints", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.webhookEndpoints", adminLanguage)}
  webhookActivePage="endpoints"
  webhookNavigation
>
  <div class="mx-auto max-w-6xl">
    <WebhookEndpointsApp client:only="react" enabled={overview.enabled} {initialEndpoints} {initialQuickstart} />
  </div>
</AdminShell>
