---
import EditChannelApp from "@/components/admin/channel/EditChannelApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import AdminShell from "../../../../layouts/AdminShell.astro";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.CONTENT_CHANNEL_MANAGE, adminLanguage);
if (denied) {
  return denied;
}
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.EDIT_CHANNEL}
  documentTitle={translate("pageDocumentTitle.editChannel", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.editChannel", adminLanguage)}
>
  <EditChannelApp client:only="react" {feedContent} {onboardingResult}>
    <AdminPageFallback slot="fallback" kind="form" />
  </EditChannelApp>
</AdminShell>
