---
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import AppAboutApp from "@/components/admin/app-about/AppAboutApp";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {hasPermission} from "@/server/rbac/guard";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// Guarded with the same code its menu row binds (`system:app-about:read`);
// saving needs `system:app-about:manage` (endpoint-enforced, surfaced here so a
// read-only account does not see a save button that would 403).
const denied = requirePagePermission(
  Astro.locals,
  PERMISSION_CODES.SYSTEM_APP_ABOUT_READ,
  adminLanguage,
);
if (denied) {
  return denied;
}
const canManage = hasPermission(
  Astro.locals,
  PERMISSION_CODES.SYSTEM_APP_ABOUT_MANAGE,
);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.APP_ABOUT}
  documentTitle={translate("pageDocumentTitle.appAbout", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.appAbout", adminLanguage)}
>
  <AppAboutApp canManage={canManage} client:only="react">
    <AdminPageFallback slot="fallback" kind="list" />
  </AppAboutApp>
</AdminShell>
