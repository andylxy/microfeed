---
import SiteFileEditorApp from "@/components/admin/site-files/SiteFileEditorApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "@/layouts/AdminShell.astro";
import {adminUrl} from "@/shared/AdminPath";
import {NAV_ITEMS} from "@/shared/Constants";
import {languageFromAcceptLanguage} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";

const adminLanguage = languageFromAcceptLanguage(
  Astro.request.headers.get("accept-language"),
);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) throw new Error("Admin feed context was not initialized.");
---

<AdminShell activeNavItem={NAV_ITEMS.SITE_FILES} documentTitle={translate("pageDocumentTitle.newSiteFile", adminLanguage)} {feedContent} {onboardingResult} pageTitle={translate("pageTitle.newSiteFile", adminLanguage)} breadcrumb={{kind: "back", name: translate("nav.item.site_files", adminLanguage), url: adminUrl("site-files", Astro.params.adminPath)}}>
  <SiteFileEditorApp client:load>
    <AdminPageFallback slot="fallback" kind="form" />
  </SiteFileEditorApp>
</AdminShell>
