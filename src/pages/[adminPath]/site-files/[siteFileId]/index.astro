---
import {env} from "cloudflare:workers";

import SiteFileEditorApp from "@/components/admin/site-files/SiteFileEditorApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {adminUrl} from "@/shared/AdminPath";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {getSiteFileById} from "@/server/site-files/service";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));

const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.CONTENT_SITE_FILE_MANAGE, adminLanguage);
if (denied) {
  return denied;
}
const file = Astro.params.siteFileId
  ? await getSiteFileById(env.FEED_DB, Astro.request, Astro.params.siteFileId)
  : null;
if (!file) Astro.response.status = 404;
---

<AdminShell activeNavItem={ADMIN_MENU_CODES.SITE_FILES} documentTitle={file ? `${translate("pageMessage.editSiteFileTitle", adminLanguage, {filename: file.filename})} | microfeed.org` : translate("pageDocumentTitle.siteFileNotFound", adminLanguage)} {feedContent} {onboardingResult} pageTitle={file ? translate("pageMessage.editSiteFileTitle", adminLanguage, {filename: file.filename}) : translate("pageTitle.siteFileNotFound", adminLanguage)} breadcrumb={{kind: "back", name: translate("menu.item.site_files", adminLanguage), url: adminUrl("site-files", Astro.params.adminPath)}}>
  {file ? <SiteFileEditorApp client:only="react" file={file} /> : <section class="rounded-[14px] border bg-card p-5 shadow-xs"><h1 class="font-semibold">{translate("pageTitle.siteFileNotFound", adminLanguage)}</h1></section>}
</AdminShell>
