---
import {env} from "cloudflare:workers";

import RbacBoardPage from "@/components/admin/rbac/RbacBoardPage.astro";
import {readRbacBoard} from "@/server/admin/rbac-handlers";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {translate} from "@/shared/i18n";
import {requirePagePermission} from "@/server/rbac/page-guard";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// B27: the permission-grant endpoints require `system:permission:manage`, and
// the menu row that leads here binds that same code — one menu row, one guard,
// no loosened validation. Role CRUD inside the board stays gated by
// `system:role:manage` at the endpoint layer, exactly as before.
const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.SYSTEM_PERMISSION_MANAGE, adminLanguage);
if (denied) {
  return denied;
}
const board = await readRbacBoard(env.FEED_DB);
---

<RbacBoardPage
  activeNavItem={ADMIN_MENU_CODES.RBAC_PERMISSIONS}
  board={board}
  documentTitle={translate("pageDocumentTitle.rbacPermissions", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.rbacPermissions", adminLanguage)}
/>
