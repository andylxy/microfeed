---
import {env} from "cloudflare:workers";

import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import RbacAuditApp from "@/components/admin/rbac/RbacAuditApp";
import AdminShell from "@/layouts/AdminShell.astro";
import {readRecentRbacAudit} from "@/server/rbac/audit";
import {requirePagePermission} from "@/server/rbac/page-guard";
import {normalizeAdminItemListLimit} from "@/shared/AdminCollections";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {ADMIN_MENU_CODES, PERMISSION_CODES} from "@/shared/Constants";
import {translate} from "@/shared/i18n";

const adminLanguage = adminLanguageFromRequest(Astro.request);
const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}

// C3: the RBAC audit trail (ext_rbac_audit, migration 0054) was write-only —
// no page ever showed it. This read-only view closes that loop. The trail
// records role and grant mutations, and the guard is `system:role:manage` —
// the same code the menu row (migration 0062) binds, one menu row one guard.
const denied = requirePagePermission(Astro.locals, PERMISSION_CODES.SYSTEM_ROLE_MANAGE, adminLanguage);
if (denied) {
  return denied;
}

// The island diffs grant/role code lists and prints 中文名, so it needs the
// code -> name catalogues. Both are seeded catalogues, not content, so their
// size is a small constant — ext_permissions is 48 rows (only migrations add to
// it), ext_roles is 4 today and grows by 1 only when an admin creates a role.
// Full scan, quantified (AGENTS「远程 D1 每日额度」):
//   当前扫描行数:       ext_permissions 48 + ext_roles 4 = 52 rows  (local D1, 2026-10-14)
//   当前读取字节数:     ≈2 KB per view (on top of `readRecentRbacAudit`'s ≤100 rows)
//   修复后预计读取字节数: 同 ≈2 KB —— 查询无谓词，没有更省的计划
//   所走索引 / 需新增索引: 无 / 无 —— predicate-less scan，任何索引都用不上
const [rows, permissionRows, roleRows] = await Promise.all([
  readRecentRbacAudit(env.FEED_DB),
  env.FEED_DB.prepare("SELECT code, name FROM ext_permissions").all<{code: string; name: string}>(),
  env.FEED_DB.prepare("SELECT code, name FROM ext_roles").all<{code: string; name: string}>(),
]);
const toNameMap = (
  result: D1Result<{code: string; name: string}>,
): Record<string, string> =>
  Object.fromEntries((result.results ?? []).map((row) => [row.code, row.name]));

// Page size from Settings → Items, same source as every other admin board.
const webSettings = feedContent.settings?.webGlobalSettings ?? {};
const itemsPerPage = normalizeAdminItemListLimit(webSettings.itemsPerPage);
---

<AdminShell
  activeNavItem={ADMIN_MENU_CODES.RBAC_AUDIT}
  documentTitle={translate("pageDocumentTitle.rbacAudit", adminLanguage)}
  {feedContent}
  {onboardingResult}
  pageTitle={translate("pageTitle.rbacAudit", adminLanguage)}
>
  <RbacAuditApp
    client:only="react"
    {itemsPerPage}
    permissionNames={toNameMap(permissionRows)}
    roleNames={toNameMap(roleRows)}
    {rows}
  >
    <AdminPageFallback slot="fallback" kind="list" />
  </RbacAuditApp>
</AdminShell>
