---
import {env} from "cloudflare:workers";

import FrontLayout from "@/layouts/FrontLayout.astro";
import CategoryShelf from "@/components/front/CategoryShelf.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadFrontSite, shouldHideFrontSite} from "@/server/catalog/site";
import {getGroupByKey} from "@/server/catalog/groups";
import {listBooksByGroup} from "@/server/catalog/books";

const slug = Astro.params.slug ?? "";
const db = env.FEED_DB;
const site = await loadFrontSite(db, Astro.request);
// 只认 book_groups.key；旧 ext_category.id 形式的地址一律查不到，直接 404。
const group = await getGroupByKey(db, slug);
const unavailable = shouldHideFrontSite(site) || !group;
if (unavailable) {
  Astro.response.status = 404;
}
const books = group && !unavailable ? await listBooksByGroup(db, group.key) : [];
---

{unavailable || !group ? (
  <PublicNotFoundHeading />
) : (
  <FrontLayout
    site={site}
    title={group.label}
    activeGroupKey={group.key}
  >
    <CategoryShelf groupLabel={group.label} books={books} />
  </FrontLayout>
)}
