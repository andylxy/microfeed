---
import {env} from "cloudflare:workers";

import {CODE_TYPES} from "@/shared/Constants";
import {loadPublishedFeed, shouldHidePublicWeb} from "@/server/feed/feed";
import Theme from "@/server/themes/Theme";
import {
  BUNDLED_DEFAULT_THEME_MANIFEST,
} from "@/server/themes/BundledThemes";
import {themeAssetBaseUrl} from "@/server/themes/ThemeAssets";
import {navigationPages} from "@/server/pages/service";
import {
  themeContext,
  renderThemeTemplate,
} from "@/shared/themes/ThemeRenderer";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import DEFAULT_WEB_CATEGORY from "../../../../themes/default/web-category.mustache?raw";
import {
  getCategoryBySlug,
  listCategoryNav,
  listChannelsByGenre,
} from "@/server/feed/extCategory";
import type {CategoryDb} from "@/server/feed/extCategory";

const slug = Astro.params.slug ?? "";
const loaded = await loadPublishedFeed(env, Astro.request, {
  includeActiveTheme: true,
});
const hidePublicWeb = shouldHidePublicWeb(loaded.content);
if (!hidePublicWeb && !loaded.onboarding.requiredOk) {
  return Astro.redirect(
    new URL(`/${env.MICROFEED_ADMIN_PATH || "admin"}/`, Astro.url),
    302,
  );
}

// `feedDb` stays D1Database-typed for the helpers that want the full binding;
// `db` narrows to the ext_category slice that the novel-cms queries use.
const feedDb = loaded.database.FEED_DB;
const db = feedDb as unknown as CategoryDb;
const category = await getCategoryBySlug(db, slug);
const unavailable = !category || !category.visible;
if (unavailable) {
  Astro.response.status = 404;
}

const webSettings = loaded.content.settings?.webGlobalSettings ?? {};
const assetBaseUrl = themeAssetBaseUrl(
  env,
  Astro.request.url,
  loaded.content.activeTheme?.assetOwnerThemeId,
  loaded.content.activeTheme?.bundle.assets,
  webSettings.publicBucketUrl,
);
const navigation = await navigationPages(feedDb, Astro.request);

const theme = new Theme(
  loaded.publicFeed,
  loaded.content.settings,
  null,
  loaded.content.activeTheme,
  assetBaseUrl,
  {navigation_pages: navigation},
);
const sharedTheme = new Theme(
  loaded.publicFeed,
  loaded.content.settings,
  CODE_TYPES.SHARED,
  loaded.content.activeTheme,
  assetBaseUrl,
  {navigation_pages: navigation},
);

let bodyHtml = "";
if (!unavailable && category) {
  const books = await listChannelsByGenre(db, category.id);
  const metadata = {
    assetBaseUrl,
    packageId: BUNDLED_DEFAULT_THEME_MANIFEST.packageId,
    version: BUNDLED_DEFAULT_THEME_MANIFEST.version,
  };
  const baseContext = themeContext(loaded.publicFeed, metadata);
  const categoryContext = {
    ...baseContext,
    navigation_pages: navigation,
    category_nav: await listCategoryNav(db),
    category: {
      name: category.name,
      slug: category.slug,
      bookCount: category.bookCount ?? 0,
    },
    category_books: books.map((book) => ({
      title: book.title,
      image: book.image,
      url: book.link || "#",
    })),
  };
  // Prefer the active theme's own genre page so the page keeps the site's look;
  // fall back to the bundled default for themes that ship without one.
  bodyHtml = renderThemeTemplate(
    theme.hasWebCategory() ? theme.getWebCategoryTmpl() : DEFAULT_WEB_CATEGORY,
    categoryContext,
  );
}
---

{unavailable || !category ? (
  <PublicNotFoundHeading />
) : (
  <PublicLayout
    title={category.name}
    description={""}
    language={loaded.publicFeed.language}
    channelImage={String(loaded.content.channel?.image ?? "")}
    favicon={webSettings.favicon}
    publicBucketUrl={webSettings.publicBucketUrl}
    headHtml={theme.getWebHeader().html}
    sharedHeadHtml={sharedTheme.getWebHeader().html}
    bodyStart={theme.getWebBodyStart().html}
    sharedBodyStart={sharedTheme.getWebBodyStart().html}
    bodyHtml={bodyHtml}
    bodyEnd={theme.getWebBodyEnd().html}
    sharedBodyEnd={sharedTheme.getWebBodyEnd().html}
    searchEnabled={theme.supportsPagesAndSearch()}
  />
)}
