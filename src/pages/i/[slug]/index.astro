---
import {env} from "cloudflare:workers";

import {CODE_TYPES, STATUSES} from "@/shared/Constants";
import {getIdFromSlug, PUBLIC_URLS} from "@/shared/StringUtils";
import Theme from "@/server/themes/Theme";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadPublishedFeed, shouldHidePublicWeb} from "@/server/feed/feed";
import {getBookById} from "@/server/feed/extCategory";
import type {CategoryDb} from "@/server/feed/extCategory";
import {themeAssetBaseUrl} from "@/server/themes/ThemeAssets";
import {loadSiteNav} from "@/server/feed/siteNav";
import {loadPublicNotFoundPageRoute} from "@/server/pages/public";
import {buildTcmMarkerLayer} from "@/server/tcm/markerPopover";

const itemId = getIdFromSlug(Astro.params.slug ?? "");
const loaded = await loadPublishedFeed(env, Astro.request, {
  includeActiveTheme: true,
  limit: 1,
  queryKwargs: {
    id: itemId ?? "__missing_item__",
    "status__in": [STATUSES.PUBLISHED, STATUSES.UNLISTED],
  },
});
const item = loaded.publicFeed.items[0];
const hidePublicWeb = shouldHidePublicWeb(loaded.content);
if (!hidePublicWeb && !loaded.onboarding.requiredOk) {
  return Astro.redirect(
    new URL(`/${env.MICROFEED_ADMIN_PATH || "admin"}/`, Astro.url),
    302,
  );
}
const unavailable = !item || hidePublicWeb;
if (unavailable) {
  Astro.response.status = 404;
}
const notFoundPage = unavailable
  ? await loadPublicNotFoundPageRoute(env, Astro.request)
  : undefined;
const webSettings = loaded.content.settings?.webGlobalSettings ?? {};
const assetBaseUrl = themeAssetBaseUrl(
  env,
  Astro.request.url,
  loaded.content.activeTheme?.assetOwnerThemeId,
  loaded.content.activeTheme?.bundle.assets,
  webSettings.publicBucketUrl,
);
const navigation = await loadSiteNav(loaded.database.FEED_DB, Astro.request);

// The reader's only navigation into the book is the 目录 link, which needs nothing
// but the chapter's own `_microfeed.bookId` — already in hand below, so it costs
// zero extra D1 reads.
//
// What used to be here: the page also fetched the chapter's *whole book* chapter
// list (`getTcmBookChapters` / `getBookChapters`) purely to work out which chapter
// is "previous" and which is "next". That stepped over the entire book — roughly
// 2,965 rows for a non-TCM book and 6,091 for a TCM one — to answer a question
// about position, which on the 5,000,000 rows_read/day free tier was the single
// most expensive thing one page could do.
//
// It cannot be made cheap instead of removed. Reading two neighbours needs a
// bounded seek over the reading-order key
// `COALESCE(json_extract(data,'$._microfeed.no'), CAST(json_extract(data,'$._microfeed.section') AS TEXT))`,
// and no index covers it: every candidate shape leaves a TEMP B-TREE behind
// (measured while tuning the book page; that is why the ordering index work was
// abandoned). Reverting to a `pub_date`/rowid order would answer the question
// cheaply but wrongly — 篇章 → 条文 would jump out of sequence.
//
// So the link stays (`toc_url`, below — the book page lists every chapter, and it
// is edge-cached for 24h so following it is free), and the neighbour buttons are
// gone. See `themes/feed-zh/web-item.mustache` for the template side.
const currentBookId = ((item?._microfeed ?? {}) as Record<string, unknown>)
  .bookId ?? null;
// A TCM book's readable sequence is 篇章 → 条文, and its 方剂 are a catalog of
// their own rather than chapters. The published-only chapter list would pull
// those 方剂 into the sequence and order everything by publish date, so a 条文
// at the end of a 篇章 linked "next" to a prescription instead of the first 条文
// of the following 篇章. The probe still gates the marker layer below.
const tcmProbe = currentBookId == null
  ? null
  : await (loaded.database.FEED_DB as unknown as CategoryDb).prepare(
      "SELECT 1 AS one FROM items WHERE book_id = ? " +
        "AND tcm_kind IS NOT NULL LIMIT 1",
    ).bind(String(currentBookId)).first();

// The book page tags every 目录 row with `id="mf-toc-<item id>"`
// (`themes/feed-zh/web-feed.mustache`), so carrying this chapter's id as a hash
// makes 返回 land on the exact row the reader came from rather than the top of
// the catalogue. On a 典籍 whose catalogue runs to eight thousand entries that
// is the difference between one click and a very long scroll.
//
// The header back button uses the same URL, so both return affordances agree on
// where "back" is. Falling back without the hash when the id is missing keeps the
// link valid rather than pointing at `#mf-toc-undefined`.
const bookUrl = currentBookId ? `/book/${currentBookId}` : "/";
const tocUrl = currentBookId != null && itemId
  ? `${bookUrl}#mf-toc-${itemId}`
  : bookUrl;

// Light metadata for the bookshelf button: the reader knows its own chapter but
// the shelf is keyed on the book, so hand the theme just enough to add one.
const book = currentBookId
  ? await getBookById(
      loaded.database.FEED_DB as unknown as CategoryDb,
      String(currentBookId),
    )
  : null;

// TCM inline-annotation markers ($f{方剂} / $u{药名} → clickable popover).
// Only activate for items that live in a TCM book (a 典籍 channel that has
// tcm_kind items); other genres keep content_html exactly as-is.
let markerLayer:
  | Awaited<ReturnType<typeof buildTcmMarkerLayer>>
  | null = null;
if (currentBookId != null && tcmProbe != null) {
  markerLayer = await buildTcmMarkerLayer(loaded.database.FEED_DB, {
    bodyHtml: String(item?.content_html ?? ""),
    title: String(item?.title ?? ""),
    currentBookId: String(currentBookId),
  });
}
const displayItem = item
  ? {...item, content_html: markerLayer?.bodyHtml ?? item.content_html}
  : item;

const extraContext = {
  ...navigation,
  book: book
    ? {
        id: String(book.id),
        title: String(book.title ?? ""),
        url: `/book/${book.id}`,
      }
    : null,
  // `chapters` / `previous_chapter` / `next_chapter` used to live here; they were
  // removed with the whole-book fetch that fed them (see the comment above).
  // `toc_url` is the only chapter navigation left, and it costs no extra read.
  toc_url: tocUrl,
  // `Theme.getWebItem` only assigns the deprecated `item` alias, while feed-zh
  // reads `items.0` — so without overriding the list the markerised body (and
  // the runtime) would never reach the template. This page fetches exactly one
  // item, so a single-element list is what every template here expects.
  items: displayItem ? [displayItem] : (loaded.publicFeed.items ?? []),
  tcmTitleHtml: markerLayer?.titleHtml ?? null,
  tcm_marker_runtime: markerLayer?.runtimeHtml ?? null,
};
const theme = new Theme(
  loaded.publicFeed,
  loaded.content.settings,
  null,
  loaded.content.activeTheme,
  assetBaseUrl,
  extraContext,
);
const sharedTheme = new Theme(
  loaded.publicFeed,
  loaded.content.settings,
  CODE_TYPES.SHARED,
  loaded.content.activeTheme,
  assetBaseUrl,
  extraContext,
);
const canonicalUrl = itemId && item
  ? PUBLIC_URLS.webItem(itemId, String(item.title ?? ""), Astro.url.origin)
  : undefined;
---

{notFoundPage?.kind === "page" ? (
  <PublicLayout {...notFoundPage.layout} />
) : unavailable || !item ? (
  <PublicNotFoundHeading />
) : (
  <PublicLayout
    title={String(item.title ?? "Untitled")}
    description={String(item.content_text ?? "")}
    language={loaded.publicFeed.language}
    canonicalUrl={canonicalUrl}
    channelImage={String(loaded.content.channel?.image ?? "")}
    favicon={webSettings.favicon}
    publicBucketUrl={webSettings.publicBucketUrl}
    headHtml={theme.getWebHeader().html}
    sharedHeadHtml={sharedTheme.getWebHeader().html}
    bodyStart={theme.getWebBodyStart().html}
    sharedBodyStart={sharedTheme.getWebBodyStart().html}
    bodyHtml={theme.getWebItem(displayItem!).html}
    bodyEnd={theme.getWebBodyEnd().html}
    sharedBodyEnd={sharedTheme.getWebBodyEnd().html}
    searchEnabled={theme.supportsPagesAndSearch()}
  />
)}
