---
import {env} from "cloudflare:workers";

import PublicLayout from "@/layouts/PublicLayout.astro";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";
import {loadPublicPageRoute} from "@/server/pages/public";

const publicPage = await loadPublicPageRoute(env, Astro.request, "404");
if (publicPage.kind === "redirect") {
  return Astro.redirect(publicPage.location, 301);
}
Astro.response.status = 404;
---

{publicPage.kind === "page" ? (
  <PublicLayout {...publicPage.layout} />
) : (
  <PublicNotFoundHeading />
)}
