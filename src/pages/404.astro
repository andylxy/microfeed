---
import {env} from "cloudflare:workers";

import {isAdminPathname, normalizeAdminPath} from "@/shared/AdminPath";
import {adminLanguageFromRequest} from "@/shared/AdminLanguage";
import {translate} from "@/shared/i18n";
import PublicNotFoundHeading from "@/components/public/PublicNotFoundHeading.astro";

// 自定义 404 页查询已下线：前台只渲染通用标题。
// `[...path].astro` 删除后，后台路径的 404 分支由本页接住，避免后台未匹配地址
// 退化成公共 NotFound 标题。后台注入缺失时沿用旧路由的就地抛错语义。
const adminLanguage = adminLanguageFromRequest(Astro.request);
const adminRequest = isAdminPathname(
  Astro.url.pathname,
  normalizeAdminPath(env.MICROFEED_ADMIN_PATH),
);
const AdminShell = adminRequest
  ? (await import("@/layouts/AdminShell.astro")).default
  : undefined;
if (adminRequest && (!Astro.locals.feedContent || !Astro.locals.onboardingResult)) {
  throw new Error(translate("errors.general.adminContextUninitialized", adminLanguage));
}
Astro.response.status = 404;
---

{adminRequest && AdminShell ? (
  <AdminShell
    activeNavItem={null}
    documentTitle={translate("pageDocumentTitle.adminNotFound", adminLanguage)}
    feedContent={Astro.locals.feedContent!}
    onboardingResult={Astro.locals.onboardingResult!}
    pageTitle={translate("errors.general.adminPageNotFound", adminLanguage)}
  >
    <section class="rounded-[14px] border bg-card p-5 text-card-foreground shadow-xs" aria-labelledby="not-found-title">
      <h1 class="mb-4 text-lg font-semibold tracking-tight" id="not-found-title">{translate("errors.general.adminPageNotFound", adminLanguage)}</h1>
      <p>{translate("errors.general.adminPageNotFoundBody", adminLanguage)}</p>
    </section>
  </AdminShell>
) : (
  <PublicNotFoundHeading />
)}
