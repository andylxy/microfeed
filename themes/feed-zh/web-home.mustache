<style>
  /* Same canvas as the book and reading pages (ADR-0010): the home page used to
     be plain white while the other two had their own greys. */
  body:has(.mf-home-page) { background: var(--mf-page-bg); }
  .mf-home-page { max-width: 1200px; margin: 0 auto; padding: 24px 24px 48px; }
  .mf-home-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  .mf-home-heading h2 { font-size: 22px; font-weight: 600; color: var(--mf-text); }
  .mf-home-heading span { font-size: 13px; color: var(--mf-muted); }
  .mf-home-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  /* Raised surface, so a book card reads the same as a .mf-detail-card. */
  .mf-home-card {
    display: flex; gap: 16px; text-decoration: none; color: inherit;
    background: var(--mf-background);
    border-radius: var(--mf-radius-card);
    padding: 1.25rem;
  }
  .mf-home-card:hover { opacity: 1; box-shadow: var(--mf-shadow-card); }
  .mf-home-cover {
    width: 96px; height: 128px; border-radius: var(--mf-radius-control); flex-shrink: 0;
    object-fit: cover;
    background: var(--mf-cover-gradient);
  }
  .mf-home-cover-empty {
    display: flex; align-items: center; justify-content: center;
    color: var(--mf-on-accent); font-size: 20px; font-weight: 600;
  }
  .mf-home-info { display: flex; flex-direction: column; justify-content: flex-start; flex: 1; min-width: 0; }
  .mf-home-title {
    font-size: 18px; font-weight: 600; color: var(--mf-text); margin-bottom: 8px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .mf-home-author { font-size: 13px; color: var(--mf-muted); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mf-home-desc {
    font-size: 13px; color: var(--mf-muted); line-height: 1.5; margin-bottom: 12px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mf-home-status { font-size: 12px; color: var(--mf-muted); margin-top: auto; }
  .mf-home-empty { color: var(--mf-muted); padding: 40px 0; text-align: center; }
  @media (max-width: 900px) { .mf-home-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .mf-home-grid { grid-template-columns: 1fr; } }
</style>

<main class="mf-home-page">
  <div class="mf-home-heading">
    <h2>书库</h2>
    <span>共 {{book_samples.length}} 本作品</span>
  </div>

  {{^book_samples.length}}
  <div class="mf-home-empty">书库暂时还没有书，去后台添加一本吧。</div>
  {{/book_samples.length}}

  <div class="mf-home-grid">
    {{#book_samples}}
    <a class="mf-home-card" href="{{url}}">
      {{#image}}<img class="mf-home-cover" src="{{image}}" alt="{{title}}" loading="lazy"/>{{/image}}
      {{^image}}<span class="mf-home-cover mf-home-cover-empty">书</span>{{/image}}
      <div class="mf-home-info">
        <h3 class="mf-home-title">{{title}}</h3>
        <p class="mf-home-author">{{#author}}{{author}}{{/author}}{{^author}}未知作者{{/author}}</p>
        {{#description}}<p class="mf-home-desc">{{description}}</p>{{/description}}
        <small class="mf-home-status">
          {{#serialStatusLabel}}{{serialStatusLabel}}{{/serialStatusLabel}}{{^serialStatusLabel}}连载中{{/serialStatusLabel}}
          {{#wordCountLabel}} · {{wordCountLabel}}{{/wordCountLabel}}
          {{#categoryName}} · {{categoryName}}{{/categoryName}}
        </small>
      </div>
    </a>
    {{/book_samples}}
  </div>
</main>
