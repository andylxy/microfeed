<style id="microfeed-design-tokens">
/* microfeed design tokens
 * For a quick color change in Admin, edit only the values in this block.
 */
:root {
  --mf-accent: #0997cc;
  --mf-background: #ffffff;
  --mf-surface: #f6f8fa;
  --mf-text: #24292f;
  --mf-muted: #57606a;
  --mf-border: #dcdcdc;
  --mf-novel: #ff6a00;
}

.dark {
  --mf-accent: #58c7f3;
  --mf-background: #0d1117;
  --mf-surface: #161b22;
  --mf-text: #f0f3f6;
  --mf-muted: #9da7b3;
  --mf-border: #30363d;
  --mf-novel: #ff8a3d;
}
</style>

<style id="microfeed-novel-styles">
/* Novel-cms additions: book header, category nav, and the volume-grouped
 * chapter list. These are new class names, so nothing here competes with the
 * compiled utility block below. */
.mf-book-head {
  margin-bottom: 2em;
}

.mf-book-title {
  margin: 0 0 .25em;
}

.mf-book-authors {
  color: var(--mf-muted);
  font-size: .875em;
}

.mf-book-badges {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: .4em;
  margin-top: .6em;
}

.mf-book-badges .badge,
.mf-category-nav .badge {
  border: 1px solid var(--mf-border);
  background: var(--mf-surface);
  border-radius: 999px;
  padding: .1em .6em;
  font-size: .8em;
  font-weight: 500;
}

.mf-book-badges .badge {
  color: var(--mf-muted);
}

.mf-book-badges a.badge {
  color: var(--mf-accent);
}

.mf-category-nav {
  display: flex;
  flex-wrap: wrap;
  gap: .5em;
  margin-bottom: 2em;
}

.mf-category-nav a {
  border: 1px solid var(--mf-border);
  border-radius: 999px;
  padding: .15em .75em;
  font-size: .875em;
}

.mf-category-nav a:hover {
  background: var(--mf-surface);
  opacity: 1;
}

.mf-toc-item {
  border-bottom: 1px solid var(--mf-border);
  padding: .6em 0;
}

.mf-toc-item:last-child {
  border-bottom: 0;
}

.mf-volume-heading {
  border-bottom: 1px solid var(--mf-border);
  color: var(--mf-muted);
  margin: 1.5em 0 .25em;
  padding-bottom: .25em;
  font-size: .95em;
  font-weight: 650;
}

.mf-volume-heading:first-child {
  margin-top: 0;
}

/* Home page: novel-store layout - genre bar, book hero, and a chapter grid.
 * Scoped to .mf-novel-home so the reading page's own TOC drawer keeps the
 * plain list it has always used. */
.mf-genre-bar {
  display: flex;
  flex-wrap: wrap;
  gap: .5em;
  margin-bottom: 1.5em;
}

.mf-genre-tab {
  align-items: center;
  border: 1px solid var(--mf-border);
  border-radius: 999px;
  display: inline-flex;
  gap: .35em;
  padding: .3em .9em;
  font-size: .9em;
}

.mf-genre-tab:hover {
  background: var(--mf-surface);
  opacity: 1;
}

.mf-genre-count {
  color: var(--mf-muted);
  font-size: .85em;
}

.mf-book-hero {
  display: grid;
  gap: 1.25em;
  grid-template-columns: 9rem 1fr;
  margin-bottom: 2em;
}

@media (max-width: 30rem) {
  .mf-book-hero {
    grid-template-columns: 1fr;
  }

  .mf-book-cover-col {
    max-width: 9rem;
  }
}

.mf-book-cover {
  aspect-ratio: 3 / 4;
  background: var(--mf-surface);
  border: 1px solid var(--mf-border);
  border-radius: .5rem;
  display: block;
  object-fit: cover;
  width: 100%;
}

.mf-book-cover--empty {
  align-items: center;
  color: var(--mf-muted);
  display: flex;
  font-size: .8em;
  justify-content: center;
}

.mf-book-info {
  min-width: 0;
}

.mf-book-title {
  font-size: 1.6em;
  font-weight: 700;
  line-height: 1.25;
  margin: 0 0 .3em;
}

.mf-book-author {
  color: var(--mf-muted);
  font-size: .9em;
  margin: 0 0 .6em;
}

.mf-book-author span + span {
  margin-left: .35em;
}

.mf-book-chips {
  display: flex;
  flex-wrap: wrap;
  gap: .4em;
  margin-bottom: .7em;
}

.mf-chip {
  background: var(--mf-surface);
  border: 1px solid var(--mf-border);
  border-radius: .25rem;
  color: var(--mf-muted);
  font-size: .78em;
  padding: .2em .5em;
}

a.mf-chip {
  color: var(--mf-accent);
}

.mf-chip--serial {
  background: var(--mf-novel);
  border-color: var(--mf-novel);
  color: #fff;
  font-weight: 600;
}

.mf-book-latest {
  color: var(--mf-muted);
  font-size: .9em;
  margin: 0 0 .7em;
}

.mf-book-latest[hidden] {
  display: none;
}

.mf-book-latest a {
  color: var(--mf-novel);
}

.mf-book-desc {
  color: var(--mf-muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  line-clamp: 4;
  overflow: hidden;
  font-size: .9em;
  margin-bottom: 1em;
}

.mf-book-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .6em;
}

.mf-btn {
  align-items: center;
  border: 1px solid var(--mf-border);
  border-radius: 999px;
  display: inline-flex;
  justify-content: center;
  padding: .45em 1.4em;
  font-size: .9em;
  font-weight: 600;
}

.mf-btn:hover {
  background: var(--mf-surface);
  opacity: 1;
}

.mf-btn--primary {
  background: var(--mf-novel);
  border-color: var(--mf-novel);
  color: #fff;
}

.mf-btn--primary:hover {
  filter: brightness(1.08);
}

.mf-subscribe {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: .75em;
  margin-top: 1em;
}

.mf-subscribe-label {
  color: var(--mf-muted);
  font-size: .85em;
}

.mf-subscribe-item {
  align-items: center;
  color: var(--mf-muted);
  display: inline-flex;
  font-size: .85em;
  gap: .3em;
}

.mf-subscribe-item img {
  height: 1.1em;
  width: 1.1em;
}

.mf-section-title {
  align-items: baseline;
  border-bottom: 1px solid var(--mf-border);
  display: flex;
  gap: .5em;
  padding-bottom: .4em;
}

.mf-section-count {
  color: var(--mf-muted);
  font-size: .7em;
  font-weight: 400;
}

.mf-section-count[hidden] {
  display: none;
}

/* Chapter grid. The volume heading spans the whole row so the flat
 * "heading + its chapters" shape the script builds still reads correctly. */
.mf-novel-home .mf-toc {
  display: grid;
  gap: .6em;
  grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  margin-top: 1em;
}

.mf-novel-home .mf-volume-heading {
  grid-column: 1 / -1;
}

.mf-novel-home .mf-toc-item {
  border: 1px solid var(--mf-border);
  border-radius: .5rem;
  padding: .6em .7em;
}

.mf-novel-home .mf-toc-item:last-child {
  border-bottom: 1px solid var(--mf-border);
}

.mf-novel-home .mf-toc-item:hover {
  background: var(--mf-surface);
}

.mf-novel-home .mf-toc-item a {
  color: var(--mf-text);
  display: block;
  font-size: .9em;
  font-weight: 500;
}

.mf-toc-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
}

.mf-toc-meta {
  color: var(--mf-muted);
  font-size: .75em;
  margin-top: .25em;
}

.mf-toc-empty {
  color: var(--mf-muted);
}

.mf-pager {
  display: flex;
  gap: .6em;
  justify-content: center;
  margin-top: 1.5em;
}

/* Prototype detail page: pale-grey canvas, white cards, three-column header,
 * and a three-column chapter list. This mirrors poto/详情面.html. */
.mf-book-detail-page,
.mf-library-page {
  background: #f5f6f8;
  min-height: 100vh;
  margin: -2em -1em -4em;
  padding: 0 1em 4em;
}

.mf-detail-container,
.mf-library-container {
  margin: 0 auto;
  max-width: 62.5rem;
}

.mf-breadcrumb {
  align-items: center;
  color: var(--mf-muted);
  display: flex;
  font-size: .8125rem;
  gap: .5em;
  padding: 1em 0;
}

.mf-breadcrumb a:hover {
  color: var(--mf-novel);
  opacity: 1;
}

.mf-sample-shelf {
  background: var(--mf-background);
  margin-bottom: 1.5em;
  padding: 1.5em 2em;
}

.mf-shelf-heading {
  align-items: baseline;
  border-bottom: 1px solid var(--mf-border);
  display: flex;
  justify-content: space-between;
  margin-bottom: 1.25em;
  padding-bottom: .75em;
}

.mf-shelf-kicker {
  color: var(--mf-novel);
  font-size: .75rem;
  margin: 0 0 .2em;
}

.mf-shelf-heading h2 {
  color: var(--mf-text);
  font-size: 1.25rem;
  margin: 0;
}

.mf-shelf-heading > a {
  color: var(--mf-novel);
  font-size: .8125rem;
}

.mf-sample-grid {
  display: grid;
  gap: 1.25em;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.mf-sample-card {
  align-items: flex-start;
  display: flex;
  gap: .75em;
  min-width: 0;
}

.mf-sample-card:hover {
  opacity: 1;
}

.mf-sample-card img,
.mf-sample-cover {
  aspect-ratio: 3 / 4;
  background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
  border-radius: .35rem;
  color: #fff;
  display: block;
  flex: 0 0 4.5rem;
  font-size: 1.5rem;
  height: 6rem;
  object-fit: cover;
  text-align: center;
  width: 4.5rem;
}

.mf-sample-cover {
  align-items: center;
  display: flex;
  justify-content: center;
}

.mf-sample-info {
  min-width: 0;
}

.mf-sample-info h3 {
  color: var(--mf-text);
  font-size: .9375rem;
  margin: 0 0 .35em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mf-sample-info p,
.mf-sample-info small {
  color: var(--mf-muted);
  display: block;
  font-size: .75rem;
  margin: 0 0 .35em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mf-detail-card {
  background: var(--mf-background);
  margin-bottom: 1.5em;
  padding: 2em;
}

.mf-book-header-card {
  display: grid;
  gap: 2em;
  grid-template-columns: 10rem minmax(0, 1fr) 12.5rem;
}

.mf-detail-cover {
  aspect-ratio: 3 / 4;
  background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
  border-radius: .5rem;
  box-shadow: 0 4px 10px rgb(0 0 0 / 10%);
  display: block;
  object-fit: cover;
  width: 100%;
}

.mf-detail-cover-empty {
  align-items: center;
  color: var(--mf-muted);
  display: flex;
  font-size: .8em;
  justify-content: center;
}

.mf-detail-main {
  border-right: 1px solid var(--mf-border);
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 2em;
}

.mf-detail-title {
  color: var(--mf-text);
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.25;
  margin: 0 0 .75em;
}

.mf-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .5em;
  margin-bottom: 1em;
}

.mf-detail-tag {
  background: var(--mf-surface);
  border: 1px solid var(--mf-border);
  border-radius: .25rem;
  color: var(--mf-muted);
  font-size: .75rem;
  padding: .2em .65em;
}

.mf-detail-tag--accent {
  background: #fff9ed;
  border-color: #ffb800;
  color: #d88900;
}

.mf-detail-word-count {
  color: var(--mf-muted);
  font-size: 1rem;
  margin-bottom: 1.5em;
}

.mf-detail-word-count strong {
  color: var(--mf-text);
  font-size: 1.5rem;
  font-weight: 600;
  margin-right: .25em;
}

.mf-detail-update {
  color: var(--mf-muted);
  display: flex;
  flex-wrap: wrap;
  font-size: .8125rem;
  gap: 1em;
  margin-bottom: 1.5em;
}

.mf-detail-update span {
  color: var(--mf-text);
}

.mf-detail-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: .75em;
  margin-top: auto;
}

.mf-detail-btn {
  align-items: center;
  border-radius: 999px;
  display: inline-flex;
  font-size: .875rem;
  font-weight: 500;
  height: 2.5rem;
  justify-content: center;
  padding: 0 1.5em;
}

.mf-detail-btn:hover {
  opacity: 1;
}

.mf-detail-btn--primary {
  background: var(--mf-novel);
  color: #fff;
}

.mf-detail-btn--primary:hover {
  background: #e65c00;
}

.mf-detail-btn--secondary,
.mf-detail-icon-btn {
  background: var(--mf-surface);
  border: 0;
  color: var(--mf-text);
}

.mf-detail-icon-btn {
  border-radius: 50%;
  cursor: pointer;
  height: 2.5rem;
  padding: 0;
  width: 2.5rem;
}

.mf-author-card {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.mf-author-avatar {
  align-items: center;
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
  border-radius: 50%;
  color: #fff;
  display: flex;
  font-size: .75rem;
  height: 4rem;
  justify-content: center;
  margin-bottom: .75em;
  overflow: hidden;
  padding: .5em;
  text-align: center;
  width: 4rem;
}

.mf-author-name {
  color: var(--mf-text);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: .5em;
}

.mf-author-badge {
  background: #ffb800;
  border-radius: .25rem;
  color: #fff;
  display: inline-block;
  font-size: .625rem;
  font-weight: 400;
  margin-right: .3em;
  padding: .1em .35em;
  vertical-align: .15em;
}

.mf-author-desc {
  color: var(--mf-muted);
  font-size: .75rem;
}

.mf-detail-section-title {
  border-bottom: 1px solid var(--mf-border);
  color: var(--mf-text);
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 1.5em;
  padding-bottom: .75em;
}

.mf-detail-intro {
  color: var(--mf-muted);
  font-size: .875rem;
  line-height: 1.8;
}

.mf-detail-empty {
  color: var(--mf-muted);
  font-size: .875rem;
}

.mf-detail-volume-title {
  color: var(--mf-text);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 1.25em;
}

.mf-detail-volume-title span {
  color: var(--mf-muted);
  font-size: .8125rem;
  font-weight: 400;
  margin-left: .5em;
}

.mf-detail-chapter-grid {
  display: grid;
  column-gap: 1.5em;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  row-gap: 1em;
}

.mf-detail-chapter-grid .mf-volume-heading {
  grid-column: 1 / -1;
}

.mf-detail-chapter-item {
  border: 0;
  min-width: 0;
  padding: 0;
}

.mf-detail-chapter-item a {
  color: var(--mf-muted);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mf-detail-chapter-item a:hover {
  color: var(--mf-novel);
  opacity: 1;
}

/* Prototype home/library page: three-column cover-and-summary cards.
 * Category pages provide the real list of channels available to this
 * single-channel microfeed instance. */
.mf-library-heading {
  align-items: end;
  display: flex;
  justify-content: space-between;
  padding: 2em 0 1em;
}

.mf-library-kicker {
  color: var(--mf-novel);
  font-size: .75rem;
  margin: 0 0 .25em;
}

.mf-library-heading h1 {
  color: var(--mf-text);
  font-size: 1.5rem;
  margin: 0;
}

.mf-library-count,
.mf-library-section-head span {
  color: var(--mf-muted);
  font-size: .8125rem;
}

.mf-library-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5em;
  margin-bottom: 1.5em;
}

.mf-library-tab {
  color: var(--mf-text);
  font-size: .875rem;
}

.mf-library-tab:hover {
  color: var(--mf-novel);
  opacity: 1;
}

.mf-library-tab small {
  color: var(--mf-muted);
  margin-left: .25em;
}

.mf-library-section {
  background: var(--mf-background);
  padding: 2em;
}

.mf-library-section-head {
  align-items: baseline;
  border-bottom: 1px solid var(--mf-border);
  display: flex;
  justify-content: space-between;
  margin-bottom: 1.5em;
  padding-bottom: .75em;
}

.mf-library-section-head h2 {
  color: var(--mf-text);
  font-size: 1.25rem;
  margin: 0;
}

.mf-library-grid {
  display: grid;
  column-gap: 2.5em;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  row-gap: 2.5em;
}

.mf-library-book-card {
  display: flex;
  gap: 1em;
  min-width: 0;
}

.mf-library-book-card:hover {
  opacity: 1;
}

.mf-library-cover {
  aspect-ratio: 3 / 4;
  background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
  border-radius: .4rem;
  flex: 0 0 6rem;
  object-fit: cover;
  width: 6rem;
}

.mf-library-cover-empty {
  align-items: center;
  color: #fff;
  display: flex;
  font-size: .7rem;
  justify-content: center;
  text-align: center;
}

.mf-library-book-info {
  min-width: 0;
}

.mf-library-book-info h3 {
  color: var(--mf-text);
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 .4em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mf-library-book-info p,
.mf-library-book-info small {
  color: var(--mf-muted);
  font-size: .75rem;
  margin: 0 0 .5em;
}

.mf-library-desc {
  color: var(--mf-muted);
  display: -webkit-box;
  font-size: .75rem;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  line-height: 1.5;
  overflow: hidden;
}

.mf-library-empty {
  color: var(--mf-muted);
  font-size: .875rem;
  padding: 1em 0;
}

@media (max-width: 50rem) {
  .mf-book-header-card {
    grid-template-columns: 9rem minmax(0, 1fr);
  }

  .mf-author-card {
    align-items: flex-start;
    border-top: 1px solid var(--mf-border);
    grid-column: 1 / -1;
    padding-top: 1em;
  }
}

@media (max-width: 42rem) {
  .mf-book-header-card,
  .mf-library-grid {
    grid-template-columns: 1fr;
  }

  .mf-detail-main {
    border-right: 0;
    padding-right: 0;
  }

  .mf-detail-cover-wrap {
    max-width: 9rem;
  }

  .mf-detail-chapter-grid,
  .mf-sample-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 25rem) {
  .mf-detail-card,
  .mf-library-section {
    padding: 1.25em;
  }

  .mf-detail-chapter-grid,
  .mf-sample-grid {
    grid-template-columns: 1fr;
  }

  .mf-sample-shelf {
    padding: 1.25em;
  }
}

/* Reading page prototype: wide white reader shell, centered 760px text column,
 * and a fixed five-button tool rail, matching poto/阅读面.html. */
body:has(.mf-reader-page) {
  background: #f2f2f2;
}

body:has(.mf-reader-page) .fq-header,
body:has(.mf-reader-page) > footer {
  display: none;
}

.mf-reader-page {
  background: #fff;
  min-height: 100vh;
  /* Was `-2em auto -4em`, cancelling the shared stylesheet's html padding.
     `html:has(.fq-header)` now zeroes that padding, so the negative margins
     would drag the reader up under the top edge and shorten the page. */
  margin: 0 auto;
  max-width: 65rem;
  padding: 0 2.5rem 3.75rem;
  position: relative;
}

.mf-reader-shell {
  min-height: 100vh;
}

.mf-reader-header {
  align-items: center;
  border-bottom: 1px solid #f0f0f0;
  display: flex;
  font-size: 1rem;
  height: 4.5rem;
  justify-content: space-between;
  margin-bottom: 2.5rem;
}

.mf-reader-back,
.mf-reader-login {
  color: #333;
  font-weight: 500;
}

.mf-reader-back {
  align-items: center;
  display: flex;
  gap: .5em;
}

.mf-reader-back:hover,
.mf-reader-login:hover {
  color: var(--mf-novel);
  opacity: 1;
}

.mf-reader-content {
  margin: 0 auto;
  max-width: 47.5rem;
}

.mf-reader-chapter-head {
  margin-bottom: 2.5rem;
}

.mf-reader-chapter-head h1 {
  color: #222;
  font-size: 1.375rem;
  font-weight: 600;
  margin: 0 0 .75em;
}

.mf-reader-meta {
  color: #999;
  display: flex;
  flex-wrap: wrap;
  font-size: .8125rem;
  gap: 1.5em;
}

.mf-reader-body {
  color: #1a1a1a;
  font-size: 1.125rem;
  line-height: 2;
}

.mf-reader-body > * {
  margin-bottom: 1.333em;
  text-align: justify;
  word-break: break-all;
}

.mf-reader-body p {
  margin-top: 0;
}

html[data-mf-font=small] .mf-reader-body { font-size: 1rem; }
html[data-mf-font=medium] .mf-reader-body { font-size: 1.125rem; }
html[data-mf-font=large] .mf-reader-body { font-size: 1.25rem; }

html[data-mf-reader-night] body:has(.mf-reader-page),
html[data-mf-reader-night] body:has(.mf-reader-page) .mf-reader-page {
  background: #202020;
}

html[data-mf-reader-night] .mf-reader-header {
  border-color: #3a3a3a;
}

html[data-mf-reader-night] .mf-reader-back,
html[data-mf-reader-night] .mf-reader-login,
html[data-mf-reader-night] .mf-reader-chapter-head h1,
html[data-mf-reader-night] .mf-reader-body {
  color: #e9e9e9;
}

.mf-reader-tools {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: fixed;
  right: max(1.25rem, calc(50% - 38rem));
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

.mf-reader-tool {
  align-items: center;
  background: #fff;
  border: 1px solid #f0f0f0;
  border-radius: .75rem;
  box-shadow: 0 4px 16px rgb(0 0 0 / 6%);
  color: #333;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  font: inherit;
  gap: .25em;
  height: 3.5rem;
  justify-content: center;
  padding: 0;
  transition: transform .2s, box-shadow .2s;
  width: 3.5rem;
}

.mf-reader-tool:hover {
  box-shadow: 0 6px 20px rgb(0 0 0 / 10%);
  opacity: 1;
  transform: translateY(-2px);
}

.mf-reader-tool span {
  font-size: 1.125rem;
  line-height: 1;
}

.mf-reader-tool small {
  color: #666;
  font-size: .6875rem;
}

.mf-reader-report {
  margin-top: 2rem;
}

.mf-reader-nav {
  align-items: center;
  border-top: 1px solid #f0f0f0;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  margin-top: 2.5rem;
