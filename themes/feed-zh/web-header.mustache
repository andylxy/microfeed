.fq-auth {
  align-items: center !important;
  display: flex !important;
  font-size: 14px !important;
  gap: 16px !important;
}

.fq-auth a {
  color: var(--mf-text) !important;
}

.fq-auth a:hover {
  color: #ff4d4f !important;
}

.fq-auth-divider {
  background: #ddd !important;
