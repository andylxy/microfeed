<main>
  <div class="mf-reading-progress" data-mf-progress aria-hidden="true"></div>

  <section class="mf-back-link">
    <a href="/">
      <div class="icon-arrow-left">{{title}}</div>
    </a>
  </section>

  <article class="mf-chapter">
    <header class="mf-chapter-head">
      <h1>{{items.0.title}}</h1>
      <div class="text-sm">
        {{#items.0._microfeed.volume}}<span>{{items.0._microfeed.volume}}</span> &middot;{{/items.0._microfeed.volume}}
        <time data-microfeed-date-ms="{{items.0._microfeed.date_published_ms}}">{{items.0._microfeed.date_published_short}}</time>
      </div>
      {{! Reading settings. The choice is applied by the script in
          web-body-end.mustache and remembered in localStorage; with JS off the
          chapter still reads normally at the default size. }}
      <div class="mf-reading-controls" data-mf-reading-controls hidden>
        <div class="mf-reading-group" role="group" aria-label="字号">
          <button type="button" data-mf-font="small">小</button>
          <button type="button" data-mf-font="medium">中</button>
          <button type="button" data-mf-font="large">大</button>
        </div>
        <div class="mf-reading-group" role="group" aria-label="背景">
          <button type="button" data-mf-paper="default">默认</button>
          <button type="button" data-mf-paper="sepia">米黄</button>
        </div>
        <button type="button" class="mf-toc-toggle" data-mf-toc-toggle aria-expanded="false">目录</button>
      </div>
    </header>

    {{#items.0.image}}
    <div class="mb-4">
      <img src="{{items.0.image}}" width="250" height="250" loading="lazy" alt=""/>
    </div>
    {{/items.0.image}}

    {{#items.0._microfeed.is_audio}}
    <div class="text-sm mb-4">收听：</div>
    {{#items.0.attachments}}
    <audio controls preload="metadata" class="w-full">
      <source src="{{url}}" type="{{mime_type}}"/>
      您的浏览器不支持音频播放。
    </audio>
    {{/items.0.attachments}}
    {{/items.0._microfeed.is_audio}}

    {{#items.0._microfeed.is_video}}
    <div class="text-sm mb-4">观看：</div>
    {{#items.0.attachments}}
    <video controls preload="metadata" class="w-full">
      <source src="{{url}}" type="{{mime_type}}"/>
      您的浏览器不支持视频播放。
    </video>
    {{/items.0.attachments}}
    {{/items.0._microfeed.is_video}}

    <div class="mf-chapter-body mf-rich-content">
      {{#items.0.content_html}}
      {{{items.0.content_html}}}
      {{/items.0.content_html}}
      {{^items.0.content_html}}
      {{#items.0.content_text}}<p>{{items.0.content_text}}</p>{{/items.0.content_text}}
      {{/items.0.content_html}}
    </div>
  </article>

  <nav class="mf-chapter-nav" aria-label="章节导航">
    {{#previous_chapter}}
    <a href="{{url}}" class="mf-chapter-nav-prev">
      <span class="icon-arrow-left"></span>
      <span class="one-line">上一章 {{title}}</span>
    </a>
    {{/previous_chapter}}
    {{^previous_chapter}}<span class="mf-chapter-nav-empty">已是第一章</span>{{/previous_chapter}}

    <a href="/" class="mf-chapter-nav-toc">目录</a>

    {{#next_chapter}}
    <a href="{{url}}" class="mf-chapter-nav-next">
      <span class="one-line">下一章 {{title}}</span>
      <span class="icon-arrow-right"></span>
    </a>
    {{/next_chapter}}
    {{^next_chapter}}<span class="mf-chapter-nav-empty">已是最后一章</span>{{/next_chapter}}
  </nav>

  {{! Table of contents. Grouped into volumes by the same client-side pass that
      handles the feed page; it is a plain <details> so it works without JS. }}
  {{#chapters.length}}
  <details class="mf-toc-drawer" data-mf-toc-drawer>
    <summary>目录（{{chapters.length}} 章）</summary>
    <div class="mf-toc" data-mf-toc data-mf-current="{{current_chapter_id}}">
      {{#chapters}}
      <div class="mf-toc-item" data-mf-volume="{{volume}}" data-mf-chapter-no="{{chapterNo}}" data-mf-chapter-id="{{id}}">
        <a href="{{url}}">{{title}}</a>
      </div>
      {{/chapters}}
    </div>
  </details>
  {{/chapters.length}}

  {{#_microfeed.subscribe_methods.length}}
  <section>
    <div class="text-sm mt-4 mb-2">订阅：</div>
    <div class="flex flex-wrap">
      {{#_microfeed.subscribe_methods}}
      <a href="{{url}}" class="mr-4 mb-2" aria-label="{{name}}">
        <div class="flex items-center">
          {{#image}}
          <img src="{{image}}" class="img-sm flex-none" alt="" loading="lazy"/>
          {{/image}}
          <div class="flex-none text-sm{{#image}} ml-1 hide-mobile{{/image}}">{{name}}</div>
        </div>
      </a>
      {{/_microfeed.subscribe_methods}}
    </div>
  </section>
  {{/_microfeed.subscribe_methods.length}}
</main>
