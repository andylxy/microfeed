<main class="mf-book-detail-page">
  <div class="mf-detail-container">
    <nav class="mf-breadcrumb" aria-label="面包屑">
      <a href="/">首页</a><span>/</span><span>{{book_title}}</span>
    </nav>

    <section class="mf-detail-card mf-book-header-card">
      <div class="mf-detail-cover-wrap">
        {{#icon}}
        <img class="mf-detail-cover" src="{{icon}}" alt="{{book_title}}" loading="lazy"/>
        {{/icon}}
        {{^icon}}
        <div class="mf-detail-cover mf-detail-cover-empty">暂无封面</div>
        {{/icon}}
      </div>

      <div class="mf-detail-main">
        <h1 class="mf-detail-title">{{book_title}}</h1>
        <div class="mf-detail-tags">
          {{#_microfeed.serialStatus}}
          <span class="mf-detail-tag mf-detail-tag--accent">
            {{#_microfeed.serialStatusFinished}}已完结{{/_microfeed.serialStatusFinished}}
            {{^_microfeed.serialStatusFinished}}连载中{{/_microfeed.serialStatusFinished}}
          </span>
          {{/_microfeed.serialStatus}}
          {{! genreName is the resolved category name; `_microfeed.genre` is only the id. }}
          {{#_microfeed.genreName}}<span class="mf-detail-tag">{{_microfeed.genreName}}</span>{{/_microfeed.genreName}}
          {{#_microfeed.tags}}<span class="mf-detail-tag">{{.}}</span>{{/_microfeed.tags}}
        </div>

        <div class="mf-detail-word-count">
          <strong>{{novel_detail.totalWordCount}}</strong> 字
        </div>
        <div class="mf-detail-update">
          <span>最近更新：{{novel_detail.latestChapterTitle}}</span>
          <time>{{novel_detail.latestDate}}</time>
        </div>

        <div class="mf-detail-actions">
          <a class="mf-detail-btn mf-detail-btn--primary" href="{{novel_detail.firstChapterUrl}}" data-mf-detail-start>开始阅读</a>
          <a class="mf-detail-btn mf-detail-btn--secondary" href="#mf-detail-catalog">查看目录</a>
          <button class="mf-detail-icon-btn" type="button" data-mf-copy-link aria-label="分享本书">分享</button>
          {{! No book id in the template context: the script reads it from the
              /book/<id>/ URL and the title from the heading below. }}
          <button class="mf-detail-icon-btn" type="button" data-mf-shelf-add data-mf-shelf-source="book">加入书架</button>
        </div>
      </div>

      <aside class="mf-author-card">
        <div class="mf-author-avatar" aria-hidden="true">{{novel_detail.author}}</div>
        <div class="mf-author-name"><span class="mf-author-badge">作者</span>{{novel_detail.author}}</div>
        <div class="mf-author-desc">用心写出不一样的故事</div>
      </aside>
    </section>

    <section class="mf-detail-card mf-detail-content-card">
      <h2 class="mf-detail-section-title">作品简介</h2>
      {{#description}}
      <div class="mf-detail-intro mf-rich-content">{{{description}}}</div>
      {{/description}}
      {{^description}}<div class="mf-detail-empty">暂无作品简介</div>{{/description}}
    </section>

    <section class="mf-detail-card mf-detail-content-card" id="mf-detail-catalog">
      <h2 class="mf-detail-section-title">目录 · {{novel_detail.totalChapterCount}}章</h2>
      <div class="mf-detail-volume-title">章节目录 <span>共 {{novel_detail.totalChapterCount}} 章</span></div>
      <div class="mf-detail-chapter-grid" data-mf-toc>
        {{^items.length}}<div class="mf-detail-empty">暂无章节</div>{{/items.length}}
        {{#items}}
        <div class="mf-toc-item mf-detail-chapter-item" data-mf-volume="{{_microfeed.volume}}" data-mf-chapter-no="{{_microfeed.chapterNo}}">
          <a href="{{_microfeed.web_url}}">{{title}}</a>
        </div>
        {{/items}}
      </div>
    </section>
  </div>
</main>
