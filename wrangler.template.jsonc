{
  "$schema": "__PROJECT_ROOT__/node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "workers_dev": __WORKERS_DEV__,
  "main": "__PROJECT_ROOT__/src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": __WORKERS_CACHE_ENABLED__
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "__PROJECT_ROOT__/dist"
  },
  "observability": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": __REQUIRED_SECRETS__
  },
  "d1_databases": [
    {
      "binding": "FEED_DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "__PROJECT_ROOT__/migrations"
    }
  ],
  __R2_BINDING__
  __WEBHOOK_BINDINGS__
  "vars": {
    "CLOUDFLARE_PROJECT_NAME": "__PROJECT_NAME__",
    "DEPLOYMENT_ENVIRONMENT": "__DEPLOYMENT_ENVIRONMENT__",
    "MICROFEED_ADMIN_AUTH_MODE": "__ADMIN_AUTH_MODE__",
    "MICROFEED_ADMIN_PATH": "__ADMIN_PATH__",
    "MICROFEED_CLOUDFLARE_ACCOUNT_ID": "__CLOUDFLARE_ACCOUNT_ID__",
    "MICROFEED_INSTANCE_ID": "__INSTANCE_ID__",
    "MICROFEED_INSTANCE_NAME": "__INSTANCE_NAME__",
    "MICROFEED_R2_BUCKET_NAME": "__R2_BUCKET_NAME__",
    "MICROFEED_R2_SETUP_MODE": "__R2_SETUP_MODE__",
    "MICROFEED_WEBHOOK_QUEUE_ID": "__WEBHOOK_QUEUE_ID__",
    "MICROFEED_WEBHOOK_QUEUE_NAME": "__WEBHOOK_QUEUE_NAME__",
    "MICROFEED_WEBHOOK_STATE": "__WEBHOOK_STATE__",
    "MICROFEED_WORKER_NAME": "__WORKER_NAME__",
    // 发信相关的两个**非 secret** 文本变量（与项目根 wrangler.jsonc 对齐）。
    // `env`（cloudflare:workers）只暴露**已声明**的绑定——`.dev.vars` 里没在
    // `vars` / `secrets.required` 登过名的键不会出现在 `env` 上。本地联调要用
    // 真实值（如 MAIL_DEV_ECHO=1），就在 `.dev.vars` 里覆盖（`.dev.vars` 优先）。
    // `RESEND_API_KEY` 走 secret（`secrets.required`），这里只登记空串占位，
    // 让 `env.RESEND_API_KEY` 在本地与线上都存在该键；真实值只从 secret 来。
    "RESEND_FROM": "",
    "RESEND_API_KEY": "",
    "MAIL_DEV_ECHO": ""
  },
  "routes": __ROUTES__
}
